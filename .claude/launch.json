{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["backend/manage.py", "runserver", "127.0.0.1:8011"],
      "port": 8011
    },
    {
      "name": "frontend",
      "runtimeExecutable": "C:/Program Files/nodejs/node.exe",
      "runtimeArgs": ["frontend/node_modules/vite/bin/vite.js", "frontend", "--config", "frontend/vite.config.ts", "--port", "5175"],
      "port": 5175,
      "env": { "VITE_BACKEND_URL": "http://127.0.0.1:8011" }
    }
  ]
}
