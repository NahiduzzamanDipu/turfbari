# TurfBari production settings for docker-compose.prod.yml.
# Copy to .env.production, fill every value, and keep that file out of git (it is ignored).

# --- Django -----------------------------------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=turfbari.com,www.turfbari.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://turfbari.com,https://www.turfbari.com
FRONTEND_URL=https://turfbari.com
PUBLIC_API_URL=https://turfbari.com/api
# Nginx in front sets X-Real-IP; trust it for audit logs and login lockouts.
TRUST_X_REAL_IP=true

# --- Database (the mysql service) -------------------------------------------
MYSQL_DATABASE=turfbari
MYSQL_USER=turfbari
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# URL-encode special characters in the password (e.g. @ -> %40).
DATABASE_URL=mysql://turfbari:CHANGE_ME@mysql:3306/turfbari

# --- Redis: cache, rate limits, Celery broker --------------------------------
REDIS_URL=redis://redis:6379/0
CACHE_URL=redis://redis:6379/1

# --- Email (plan-expiry reminders) --------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=TurfBari <no-reply@turfbari.com>

# --- Subscription payments ------------------------------------------------------
TURFBARI_BKASH_NUMBER=
TURFBARI_NAGAD_NUMBER=
TURFBARI_ROCKET_NUMBER=
TURFBARI_BANK_DETAILS=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=false

# --- SMS (BulkSMSBD). Whitelist the server's outbound IP in BulkSMSBD if your account requires it.
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=
SMS_BACKEND=bulksmsbd
# Long random secret; an external cron POSTs /api/system/tick/ with header X-Tick-Token every 5-10 min.
TICK_TOKEN=
TEMP_PASSWORD_HOURS=72

# --- Optional: S3-compatible media storage (R2, Spaces, S3). Leave empty to keep the media volume.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Optional -------------------------------------------------------------------
SENTRY_DSN=
HTTP_PORT=80
