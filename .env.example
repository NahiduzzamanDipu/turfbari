# TURFOS environment configuration.
# Copy to `.env` in the repository root and fill in values. Never commit `.env`.

# --- Django -----------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# --- Database: XAMPP MariaDB 10.6+ or MySQL 8 --------------------------------
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# XAMPP: use host [::1] (or 127.0.0.1 if no other MySQL server is bound there).
# URL-encode special characters in the password (e.g. @ -> %40).
MYSQL_DATABASE=turfos
MYSQL_USER=turfos
MYSQL_PASSWORD=change-me
MYSQL_PORT=3306
DATABASE_URL=mysql://turfos:change-me@[::1]:3306/turfos

# --- Redis / Celery ---------------------------------------------------------
# CACHE_URL empty = in-process memory cache (local dev only). Production MUST set it.
REDIS_URL=redis://localhost:6379/0
CACHE_URL=

# --- Email (Mailpit catches everything locally: http://localhost:8025) ------
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=TURFOS <no-reply@turfos.local>

# --- Production only --------------------------------------------------------
# DJANGO_SETTINGS_MODULE=config.settings.prod
# CACHE_URL=redis://localhost:6379/1
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# SENTRY_DSN=
